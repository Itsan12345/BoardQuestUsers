# ==============================================================================
# BoardQuest - Environment Variables Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` or `.env.local` for local development.
# 2. Fill in the placeholder values with your actual service credentials.
# 3. SECURITY WARNING: NEVER commit your actual `.env` file to version control!
#    Ensure `.env` remains in `.gitignore`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB / Prisma)
# ------------------------------------------------------------------------------
# Connection string for MongoDB (Atlas or local instance).
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/boardquest?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. ARTIFICIAL INTELLIGENCE (Google Gemini API)
# ------------------------------------------------------------------------------
# API Key for Google Gemini LLM used for AI question generation, explanations, etc.
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-google-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. EMAIL DELIVERY SERVICES
# ------------------------------------------------------------------------------
# Choose an email delivery provider: 'resend' or 'gmail'
# In deployed environments (e.g., Render, Vercel), 'resend' is prioritized.
EMAIL_PROVIDER="resend"

# --- Option A: Resend (Recommended for Production & Cloud Hosting) ---
# Obtain from Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
# Verified sender domain address in Resend (e.g., "BoardQuest <noreply@yourdomain.com>")
RESEND_FROM="BoardQuest <onboarding@resend.dev>"

# --- Option B: Gmail SMTP / Custom SMTP (Development / Fallback) ---
# Gmail user account email and 16-character Google App Password (not your personal password)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional Custom SMTP Server settings:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="\"BoardQuest\" <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Optional / Extended)
# ------------------------------------------------------------------------------
# Secure random secrets used for signing tokens and sessions
SESSION_SECRET="your-secure-session-secret"
JWT_SECRET="your-secure-jwt-secret"

# ------------------------------------------------------------------------------
# 5. REALTIME / WEBSOCKETS (Pusher - Optional)
# ------------------------------------------------------------------------------
# Configuration for live multiplayer / real-time updates
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="ap1"

# ------------------------------------------------------------------------------
# 6. ENVIRONMENT RUNTIME FLAGS
# ------------------------------------------------------------------------------
# NODE_ENV="development" # or "production"
# RENDER="false"         # Set to "true" automatically on Render deployment
# VERCEL="0"             # Set to "1" automatically on Vercel deployment
# IS_DEPLOYED="false"    # Manual flag for cloud environments
